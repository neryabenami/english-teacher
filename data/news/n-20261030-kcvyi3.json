emma":"George Hannah","pos":"noun","he":"ג'ורג' האנה","name":"true"},{"text":"British Association of Social Workers","lemma":"British Association of Social Workers","pos":"noun","he":"האיגוד הבריטי של עובדים סוציאליים","name":"true"},{"text":"echoed","lemma":"echo","pos":"verb","he":"הדהד / חזר על","name":false},{"text":"fears","lemma":"fear","pos":"noun","he":"חששות","name":false},{"text":"rollout","lemma":"rollout","pos":"noun","he":"השקה / פריסה","name":false},{"text":"sufficient","lemma":"sufficient","pos":"adj","he":"מספיק","name":false},{"text":"resources","lemma":"resource","pos":"noun","he":"משאבים","name":false},{"text":"safely","lemma":"safely","pos":"adv","he":"בבטחה","name":false},{"text":"vulnerable","lemma":"vulnerable","pos":"adj","he":"פגיע","name":false},{"text":"individuals","lemma":"individual","pos":"noun","he":"פרטים / אנשים","name":false},{"text":"adequately","lemma":"adequately","pos":"adv","he":"כראוי","name":false},{"text":"Ultimately","lemma":"ultimately","pos":"adv","he":"בסופו של דבר","name":"false"},{"text":"maintains","lemma":"maintain","pos":"verb","he":"טוען / גורס","name":false},{"text":"approach","lemma":"approach","pos":"noun","he":"גישה","name":false},{"text":"avoidable","lemma":"avoidable","pos":"adj","he":"שניתן להימנע ממנו","name":false},{"text":"delays","lemma":"delay","pos":"noun","he":"עיכובים","name":false},{"text":"consistency","lemma":"consistency","pos":"noun","he":"עקביות","name":false},{"text":"decision-making","lemma":"decision-making","pos":"noun","he":"קבלת החלטות","name":false},{"text":"lawful","lemma":"lawful","pos":"adj","he":"חוקי","name":false},{"text":"practice","lemma":"practice","pos":"noun","he":"פרקטיקה / עשייה","name":false},{"text":"specialized","lemma":"specialized","pos":"adj","he":"מתמחה","name":false},{"text":"professionals","lemma":"professional","pos":"noun","he":"אנשי מקצוע","name":false},{"text":"availability","lemma":"availability","pos":"noun","he":"זמינות","name":false},{"text":"shadow","lemma