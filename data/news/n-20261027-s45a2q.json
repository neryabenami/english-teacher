","he":"עדכונים","name":false},{"text":"polls","lemma":"poll","pos":"noun","he":"מדגמים / סקרים","name":false},{"text":"monotony","lemma":"monotony","pos":"noun","he":"מונוטוניות / שעמום","name":false},{"text":"escape","lemma":"escape","pos":"verb","he":"להימלט / לברוח","name":false},{"text":"constant","lemma":"constant","pos":"adjective","he":"מתמיד","name":false},{"text":"coverage","lemma":"coverage","pos":"noun","he":"סיקור","name":false},{"text":"distractions","lemma":"distraction","pos":"noun","he":"הסחות דעת / עיסוקים","name":false},{"text":"problematic","lemma":"problematic","pos":"adjective","he":"בעייתי","name":false},{"text":"provided","lemma":"provided","pos":"conjunction","he":"בתנאי ש","name":false},{"text":"aligns","lemma":"align","pos":"verb","he":"מתאים / מתיישר","name":false},{"text":"deliberate","lemma":"deliberate","pos":"adjective","he":"מכוון / מתוכנן","name":false},{"text":"planning","lemma":"planning","pos":"noun","he":"תכנון","name":false},{"text":"impulsive","lemma":"impulsive","pos":"adjective","he":"אימפולסיבי","name":false},{"text":"reactions","lemma":"reaction","pos":"noun","he":"תגובות","name":false},{"text":"promotional","lemma":"promotional","pos":"adjective","he":"שיווקי / של מבצעים","name":false},{"text":"campaigns","lemma":"campaign","pos":"noun","he":"קמפיינים / מבצעים","name":false},{"text":"genuine","lemma":"genuine","pos":"adjective","he":"אמיתי","name":false},{"text":"savings","lemma":"saving","pos":"noun","he":"חיסכון","name":false},{"text":"artificial","lemma":"artificial","pos":"adjective","he":"מלאכותי","name":false},{"text":"desires","lemma":"desire","pos":"noun","he":"רצונות","name":false},{"text":"intended","lemma":"intend","pos":"verb","he":"התכוון","name":false},{"text":"budget","lemma":"budget","pos":"noun","he":"תקציב","name":false},{"text":"outlining","lemma":"outline","pos":"verb","he":"מתווה","name":false},{"text":"schedule","lemma":"schedule","pos":"noun","he":"לוח זמנים","name":false},{"text":"prevent","lemma":