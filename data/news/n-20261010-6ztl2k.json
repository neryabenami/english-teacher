ה","name":false},{"text":"honeyed","lemma":"honeyed","pos":"adjective","he":"עם דבש / ממותק בדבש","name":false},{"text":"conventional","lemma":"conventional","pos":"adjective","he":"רגיל / קונבנציונלי","name":false},{"text":"cow's milk","lemma":"cow's milk","pos":"noun","he":"חלב בקר","name":false},{"text":"economical","lemma":"economical","pos":"adjective","he":"חסכוני / זול","name":false},{"text":"post-run","lemma":"post-run","pos":"adjective","he":"שלאחר הריצה","name":false},{"text":"protein","lemma":"protein","pos":"noun","he":"חלבון","name":false},{"text":"flexibility","lemma":"flexibility","pos":"noun","he":"גמישות","name":false},{"text":"brief","lemma":"brief","pos":"adjective","he":"קצר","name":false},{"text":"stretches","lemma":"stretch","pos":"noun","he":"מתיחות","name":false},{"text":"physiological utility","lemma":"physiological utility","pos":"noun","he":"תועלת פיזיולוגית","name":false},{"text":"advocate","lemma":"advocate","pos":"verb","he":"מצדדים ב- / ממליצים על","name":false},{"text":"pilates","lemma":"pilates","pos":"noun","he":"פילאטיס","name":false},{"text":"unilateral","lemma":"unilateral","pos":"adjective","he":"חד-צדדי (אימון על רגל אחת)","name":false},{"text":"split squats","lemma":"split squat","pos":"noun","he":"סקוואט מכרע / ספליט סקוואט","name":false},{"text":"lunges","lemma":"lunge","pos":"noun","he":"מכרעים / לאנג'ים","name":false},{"text":"single-leg calf raises","lemma":"single-leg calf raise","pos":"noun","he":"הרמות עקבים על רגל אחת","name":false},{"text":"plyometric","lemma":"plyometric","pos":"adjective","he":"פליאומטרי (תרגילי ניתור)","name":false},{"text":"muscle mass","lemma":"muscle mass","pos":"noun","he":"מסת שריר","name":false},{"text":"bone density","lemma":"bone density","pos":"noun","he":"צפיפות עצם","name":false},{"text":"unaddressed","lemma":"unaddressed","pos":"adjective","he":"ללא טיפול","name":false},{"text":"exacerbate","lemma":"exacerbate","pos":"verb","he":"להחמיר","name":false}]}