","pos":"verb","he":"מנווט","name":false},{"text":"motherhood","lemma":"motherhood","pos":"noun","he":"אימהות","name":false},{"text":"crying","lemma":"crying","pos":"noun","he":"בכי","name":false},{"text":"expectation","lemma":"expectation","pos":"noun","he":"ציפייה","name":false},{"text":"instinctively","lemma":"instinctively","pos":"adverb","he":"באופן אינסטינקטיבי","name":false},{"text":"clue","lemma":"clue","pos":"noun","he":"מושג","name":false},{"text":"Participants","lemma":"participant","pos":"noun","he":"משתתפים","name":"p"},{"text":"emphasized","lemma":"emphasize","pos":"verb","he":"הדגיש","name":false},{"text":"dedicated","lemma":"dedicated","pos":"adjective","he":"ייעודי","name":false},{"text":"infants","lemma":"infant","pos":"noun","he":"תינוקות","name":false},{"text":"alleviate","lemma":"alleviate","pos":"verb","he":"להקל","name":false},{"text":"anxiety","lemma":"anxiety","pos":"noun","he":"חרדה","name":false},{"text":"Financial","lemma":"financial","pos":"adjective","he":"פיננסי","name":"f"},{"text":"sector","lemma":"sector","pos":"noun","he":"מגזר","name":false},{"text":"intensified","lemma":"intensify","pos":"verb","he":"התעצם","name":false},{"text":"notably","lemma":"notably","pos":"adverb","he":"במיוחד","name":false},{"text":"driven","lemma":"drive","pos":"verb","he":"מונע על ידי","name":false},{"text":"cost-of-living crisis","lemma":"cost-of-living crisis","pos":"noun","he":"משבר יוקר המחיה","name":false},{"text":"simultaneously","lemma":"simultaneously","pos":"adverb","he":"בו זמנית","name":false},{"text":"running costs","lemma":"running cost","pos":"noun","he":"עלויות תפעול","name":false},{"text":"donor funding","lemma":"donor funding","pos":"noun","he":"מימון תורמים","name":false},{"text":"Comic Relief","lemma":"Comic Relief","pos":"proper noun","he":"קומיק ריליף","name":"c"},{"text":"The National Lottery","lemma":"The National Lottery","pos":"proper noun","he":"הלוטו הלאומי","name":"t"},{"text":"The Cumbria Foundation","lemma":"The Cumbria Fou